# Path is relative to prisma/schema.prisma
DATABASE_URL="file:../data/students.db"

GMAIL_USER="your-gmail-address@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-gmail-app-password"

# --- HackerRank contest integration (server-side only, never exposed to the browser) ---
HACKERRANK_BASE_URL="https://www.hackerrank.com"
HACKERRANK_CONTEST_SLUG="optus-sde-hiring-assessment-2026"
HACKERRANK_QUESTION_SLUGS="castle-on-the-grid,new-year-chaos"
# Paste the full Cookie header value from a logged-in browser request (DevTools > Network >
# judge_submissions request > Request Headers > cookie). Use SINGLE quotes: the cookie contains
# `#` and `"` characters, which break double-quoted .env values.
HACKERRANK_SESSION_COOKIE=''
# The x-csrf-token request header from the same request.
HACKERRANK_CSRF_TOKEN=""
# Optional: override the User-Agent sent to HackerRank (use your browser's if requests get blocked).
HACKERRANK_USER_AGENT=""
HACKERRANK_LEADERBOARD_PAGE_SIZE=100
HACKERRANK_SUBMISSIONS_PAGE_SIZE=100
HACKERRANK_MAX_PAGES=1000
# Optional ISO-8601 contest start with an explicit timezone, e.g. 2026-09-25T15:00:00+05:30.
# Only used as a fallback when a submission has no time_from_start.
HACKERRANK_CONTEST_START_AT=""

# --- HackerRank ADMIN account for the "HackerRank Contests" tab (separate account, separate session) ---
# The server logs in with these, stores the session encrypted in data/hackerrank-admin-session.json
# (git-ignored) and logs in again automatically whenever the session expires.
# Use SINGLE quotes. If the password contains a $ sign, write it as \$ (Next.js expands $NAME),
# or instead set HACKERRANK_ADMIN_PASSWORD_BASE64 (output of: printf %s 'password' | base64).
HACKERRANK_ADMIN_LOGIN=''
HACKERRANK_ADMIN_PASSWORD=''
HACKERRANK_ADMIN_PASSWORD_BASE64=''
# Optional fallback if HackerRank requires extra verification: a browser cookie header for the admin account.
HACKERRANK_ADMIN_SESSION_COOKIE=''
HACKERRANK_ADMIN_CSRF_TOKEN=''
# Optional overrides
HACKERRANK_ADMIN_BASE_URL=''
HACKERRANK_ADMIN_USER_AGENT=''
